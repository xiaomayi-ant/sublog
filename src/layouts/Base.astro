---
// Base — 全站基础布局：lang=zh-CN、发布元数据、skip link、nav / main / footer
import '../styles/tokens.css';
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteFooterMinimal from '../components/SiteFooterMinimal.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'article';
  noIndex?: boolean;
  // 索引页用完整落款（默认）；文章页传 minimal，只留一条工具行收尾
  // 落款（sumoer / Vision: world peace）只属于首页 —— 它是站点身份的一次性出现，
  // 每一页都重复一遍反而稀释它。其余页面一律只留最底那条工具行。
  footer?: 'signature' | 'minimal';
}

const {
  title,
  description = 'Water — 关于时间、流动、智能系统与未来的个人研究与构建空间。',
  image = '/og-default.svg',
  ogType = 'website',
  noIndex = false,
  footer = 'minimal',
} = Astro.props;

const site = Astro.site ?? new URL('https://water.localhost');
const canonical = new URL(Astro.url.pathname, site);
const socialImage = new URL(image, site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Water</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noIndex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="Water — 研究" href="/rss.xml" />
    <meta property="og:site_name" content="Water" />
    <meta property="og:title" content={`${title} · Water`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · Water`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {/* 两个都给：支持 SVG 的浏览器用矢量那份，旧版 Safari 与部分抓取器只认 .ico。
        .ico 由 SVG 生成（16/32/48），改图标时两份要一起换，否则会出现
        "Chrome 已经是新图标、别处还是旧的"。 */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">跳到主要内容</a>
    <SiteNav />
    <main id="content" class="site-shell">
      <slot />
    </main>
    {footer === 'signature' ? <SiteFooter /> : <SiteFooterMinimal />}
  </body>
</html>
