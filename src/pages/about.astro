---
// /about — 全站最该简单的一页：一句话说清这里是什么，三段说清在关注什么、
// 有什么、去哪找，收在那句引言上。
//
// 之前这一页有五个视觉区块（大标题 / 一条斜的河纹装饰线 / 等权重两栏 / 外链行 / 引言），
// 三处问题：01-02-03 在假装那三条原则有顺序（它们没有）；那条河纹不承载任何信息，
// 而 site-direction 明确要求河流是分隔或连接版块的结构线、不是装饰背景；
// 两栏不等长，右栏早早收尾，底下拖出一片死白 —— 是空，不是留白。
// 现在收成单栏、窄行宽，自上而下读完，中间只有发丝线分段。
import Base from '../layouts/Base.astro';
import Meta from '../components/Meta.astro';
---

<Base title="About" description="关于 Sumoer，以及这个站在记录什么。">
  <article class="about">
    <header class="head">
      <Meta items={['About', 'Sumoer']} />
      <h1>About</h1>
      <p class="lead">
        这里是 Sumoer 的个人研究与构建空间。记录尚未定型的想法，也展示已经可以被使用的东西。
      </p>
    </header>

    <section class="block" aria-labelledby="focus">
      <h2 id="focus">正在关注</h2>
      <p>
        智能系统如何获得可靠的行动边界，工具如何保留人的判断，以及时间如何改变产品与知识的形态。
      </p>
    </section>

    <section class="block" aria-labelledby="shape">
      <h2 id="shape">这里有什么</h2>
      <p>
        内容分成文章、笔记和实验：文章试着形成观点，笔记保留过程，实验用实现去校验直觉。
        同一批文章还有另外两种读法 —— <a href="/graph">图谱</a>把它们按概念连起来，
        <a href="/albums">相册</a>把它们按月收成册。
      </p>
    </section>

    <section class="block" aria-labelledby="method">
      <h2 id="method">一种工作方式</h2>
      {/* 三条并列的原则，不是流程 —— 所以不编号。之前的 01/02/03 是假的序列。 */}
      <ul class="method">
        <li>先观察真实问题，再决定抽象。</li>
        <li>把边界写清楚，再让系统行动。</li>
        <li>留下可以复用的工具与文字。</li>
      </ul>
    </section>

    <section class="block" aria-labelledby="elsewhere">
      <h2 id="elsewhere">去哪找我</h2>
      <p>
        写下来的东西在这里，写出来的在 <a
          href="https://github.com/xiaomayi-ant"
          rel="noreferrer"
          target="_blank">GitHub<span class="out" aria-hidden="true">↗</span></a
        >。
      </p>
    </section>

    <p class="epigraph">
      “Be water, my friend.”
      <span class="epigraph-note meta">A reminder to stay adaptive without losing form.</span>
    </p>
  </article>
</Base>

<style>
  /* 单栏、窄行宽。一页从上读到下，不需要读者决定先看左还是先看右。 */
  .about {
    max-width: var(--measure);
    padding-top: var(--space-xl);
  }

  h1 {
    font-family: var(--font-display);
    margin-top: var(--space-sm);
    font-size: var(--text-3xl);
  }

  .lead {
    margin-top: var(--space-lg);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.9;
  }

  /* 分段只靠一条发丝线 —— 和全站其他地方分段的手法一致 */
  .block {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  h2 {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  .block p {
    margin-top: var(--space-sm);
    color: var(--color-ink-soft);
    line-height: 1.9;
  }

  .method {
    margin-top: var(--space-sm);
    display: grid;
    gap: var(--space-xs);
    color: var(--color-ink-soft);
    line-height: 1.9;
  }

  /* 悬挂的短横：说明这三条是并列的，而不是有先后 */
  .method li {
    padding-left: 1.1em;
    text-indent: -1.1em;
  }

  .method li::before {
    content: '—';
    margin-right: 0.5em;
    color: var(--color-ink-faint);
  }

  .about a {
    color: var(--color-ink);
    text-decoration: none;
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .about a:hover {
    background-size: 100% 1px;
  }

  .out {
    margin-left: 0.2em;
    font-size: 0.8em;
    vertical-align: 0.15em;
  }

  /* 收尾的引言：去掉了那道黄色左边框 —— 它是全站独一份的样式。
     现在只靠字体和位置把它和正文分开。 */
  .epigraph {
    margin-top: var(--space-2xl);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.7;
    color: var(--color-ink);
  }

  .epigraph-note {
    display: block;
    margin-top: var(--space-sm);
    color: var(--color-ink-faint);
  }
</style>
