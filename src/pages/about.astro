---
// /about — 这一页的职责只有一个：让刚到的人在半分钟内判断这里值不值得继续待。
// 不是简历，不是宣言，也不是站点说明书。
//
// 判断每一块该不该留，只问一句：删掉它，读者会少知道什么？
//   标题与那两句 —— 删了就不知道这是什么站。留，且是主角。
//   这里有什么   —— 删了不知道怎么逛。留，它承担导航。
//   最近在写     —— 读者在这一页真正会问的是"这个站还活着吗"，
//                   而这件事 Blog 页看不出来，只有这里会被问到。
//   去哪找我     —— 删了就没有出口。留，但不占一个小节，做成收尾的一行。
// 「一种工作方式」那三条已经删掉：正确但普适，任何人都能写，删了读者不少知道任何东西。
//
// 「最近在写」是自动取的，永不过期。没有把知识图谱的概念标签搬过来 ——
// 那是 /graph 的职责，重复一遍只是把同一批数据讲第二次；而且抽取结果还带着噪声，
// 不该出现在身份页上。
import Base from '../layouts/Base.astro';
import Meta from '../components/Meta.astro';
import { ossImage } from '../lib/oss';
import { TYPE_LABELS, formatDate, getAllResearch } from '../lib/content';

const [latest] = await getAllResearch();

const shelves = [
  { name: '文章', note: '试着形成观点', href: '/blog' },
  { name: '笔记', note: '保留过程', href: '/blog' },
  { name: '实验', note: '用实现去校验直觉', href: '/lab/river' },
];

const lenses = [
  { name: '图谱', note: '把它们按概念连起来', href: '/graph' },
  { name: '相册', note: '把它们按月收成册', href: '/albums' },
];
---

<Base title="About" description="关于 Sumoer，以及这个站在记录什么。">
  <div class="about-grid">
    <article class="about">
      <header>
        <Meta items={['About', 'Sumoer']} />
        <h1>这里是 Sumoer 的<br />个人研究与构建空间</h1>
        <p class="sub">记录尚未定型的想法，也展示已经可以被使用的东西。</p>
      </header>

      {
        latest && (
          <section class="block recent" aria-labelledby="recent">
            <h2 id="recent">最近在写</h2>
            <p>
              <a href={`/blog/${latest.collection}/${latest.id}`}>{latest.data.title}</a>
              <span class="when meta">
                {formatDate(latest.data.pubDate)} · {TYPE_LABELS[latest.collection].zh}
              </span>
            </p>
          </section>
        )
      }

      <section class="block" aria-labelledby="shape">
        <h2 id="shape">这里有什么</h2>
        <dl class="shelf">
          {
            shelves.map((item) => (
              <>
                <dt>
                  <a href={item.href}>{item.name}</a>
                </dt>
                <dd>{item.note}</dd>
              </>
            ))
          }
        </dl>
        <p class="shelf-note">同一批文章还有另外两种读法 ——</p>
        <dl class="shelf">
          {
            lenses.map((item) => (
              <>
                <dt>
                  <a href={item.href}>{item.name}</a>
                </dt>
                <dd>{item.note}</dd>
              </>
            ))
          }
        </dl>
      </section>

      {/* 出口。不占一个小节，也不做成按钮 —— 站点是克制的，按钮会打架。
          略重于正文的一行，读完自然撞上。 */}
      <p class="exit">
        <a href="https://github.com/xiaomayi-ant" rel="noreferrer" target="_blank">
          到我的 GitHub 看看<span class="out" aria-hidden="true">↗</span>
        </a>
        <span class="exit-note meta">写下来的东西在这里，写出来的在那边。</span>
      </p>
    </article>

    {/* 图与引言是一组：石头是"形"，静水是"适应"，正是下面那句话说的事。
        图存在 OSS 上，构建产物不因为它变大。 */}
    <figure class="figure">
      <img
        src={ossImage('site/about.jpg', 'full')}
        alt="一块被水磨圆的灰色河石，旁边是一只盛着静水的浅陶碟，纸面上一条细蓝线从两者下方穿过"
        width="1600"
        height="2133"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        “Be water, my friend.”
        <span class="note meta">A reminder to stay adaptive without losing form.</span>
      </figcaption>
    </figure>
  </div>
</Base>

<style>
  /* 正文限在 --measure（中文一行超过三十几个字，眼睛回行容易串行），
     图占右侧剩余宽度但不无限长大 */
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 22rem);
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-top: var(--space-xl);
  }

  /* 主标题是这一页真正的信息。原来的 H1 是「About」——
     那是个归档标签，不是内容，让它退到上面那行眉标里去。 */
  h1 {
    margin-top: var(--space-sm);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.5;
    text-wrap: balance;
  }

  .sub {
    margin-top: var(--space-md);
    color: var(--color-ink-soft);
    font-size: var(--text-lg);
    line-height: 1.9;
  }

  .block {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  h2 {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  /* 最近在写：自动取最新一篇，回答"这个站还活着吗" */
  .recent p {
    margin-top: var(--space-sm);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .when {
    display: block;
    margin-top: var(--space-2xs);
    color: var(--color-ink-faint);
  }

  /* 名称 + 说明的两列。散文把枚举的结构藏起来了，列表让它可扫、也让链接更像能点。 */
  .shelf {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-md);
    line-height: 1.8;
  }

  .shelf dt {
    font-family: var(--font-serif);
    color: var(--color-ink);
  }

  .shelf dd {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .shelf-note {
    margin-top: var(--space-lg);
    color: var(--color-ink-faint);
  }

  .exit {
    margin-top: var(--space-2xl);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .exit-note {
    display: block;
    margin-top: var(--space-2xs);
    color: var(--color-ink-faint);
    font-family: var(--font-sans);
  }

  .about a {
    color: var(--color-ink);
    text-decoration: none;
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .about a:hover {
    background-size: 100% 1px;
  }

  .out {
    margin-left: 0.2em;
    font-size: 0.8em;
    vertical-align: 0.15em;
  }

  /* 图不加边框圆角：它的纸底和页面的纸底是同一种白，画个框反而把它从页面上剪下来 */
  .figure {
    margin: 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--color-line);
  }

  .figure figcaption {
    margin-top: var(--space-md);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .note {
    display: block;
    margin-top: var(--space-xs);
    color: var(--color-ink-faint);
  }

  @media (max-width: 60rem) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .figure {
      max-width: 22rem;
    }
  }
</style>
