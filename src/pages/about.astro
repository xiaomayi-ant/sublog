---
// /about — 这一页的职责只有一个：让刚到的人在半分钟内判断这里值不值得继续待。
// 不是简历，不是宣言，也不是站点说明书。
//
// 四块各有职责，没有一块是模板槽位：
//   标题与副标题 —— 这是什么、什么口味
//   近来喜欢     —— 这个站还活着吗（自动取最新三篇，永不过期）
//   这里有什么   —— 怎么逛（导航）
//   出口         —— 去哪找我
// 右栏的图不说话，但它决定读者觉得这个站是什么调性。
import Base from '../layouts/Base.astro';
import Meta from '../components/Meta.astro';
import { ossImage } from '../lib/oss';
import { TYPE_LABELS, formatDate, getAllResearch } from '../lib/content';

// 三条。一条看不出节奏，五条就成了另一个 Blog 索引。
const recent = (await getAllResearch()).slice(0, 3);

// 徽章两组：上面一组是内容本身，下面一组是同一批内容的另外两种读法。
// 组名承担了说明职责，所以每一枚不再各带一句注解 —— 那样就退回列表了。
const badgeGroups = [
  {
    label: '内容',
    items: [
      { name: '文章', href: '/blog' },
      { name: '笔记', href: '/blog' },
      { name: '实验', href: '/lab/river' },
    ],
  },
  {
    label: '读法',
    items: [
      { name: '图谱', href: '/graph' },
      { name: '相册', href: '/albums' },
    ],
  },
];
---

<Base title="About" description="关于 Sumoer，以及这个站在记录什么。">
  <div class="about-grid">
    <article class="about">
      <header>
        <Meta items={['About', 'Sumoer']} />
        <h1>Sumoer 找了点有趣的东西放在这里。</h1>
        <p class="sub">If it's interesting, it's worth chasing.</p>
      </header>

      {
        recent.length > 0 && (
          <section class="block" aria-labelledby="recent">
            <h2 id="recent">近来喜欢</h2>
            <ul class="recent">
              {recent.map((entry) => (
                <li>
                  <a href={`/blog/${entry.collection}/${entry.id}`}>{entry.data.title}</a>
                  <span class="when meta">
                    {formatDate(entry.data.pubDate)} · {TYPE_LABELS[entry.collection].zh}
                  </span>
                </li>
              ))}
            </ul>
            <p class="more">
              <a href="/blog">More<span class="arrow" aria-hidden="true">→</span></a>
            </p>
          </section>
        )
      }

      <section class="block" aria-labelledby="shape">
        <h2 id="shape">这里有什么</h2>
        {
          badgeGroups.map((group) => (
            <div class="badge-row">
              <span class="badge-label meta">{group.label}</span>
              <span class="badges">
                {group.items.map((item) => (
                  <a class="badge" href={item.href}>
                    {item.name}
                  </a>
                ))}
              </span>
            </div>
          ))
        }
      </section>

    </article>

    <aside class="side">
      {/* 图与引言是一组：石头是"形"，静水是"适应"，正是下面那句话说的事。
          图存在 OSS 上，构建产物不因为它变大。 */}
      <figure class="figure">
        <img
          src={ossImage('site/about-v3.jpg', 'full')}
          alt="一片散落在白纸上的鹅卵石，多数是白色与玉色、圆润饱满，其中几颗还湿着泛出光泽，另有几颗深色和一颗赭红点缀其间"
          width="1600"
          height="2133"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          “Be water, my friend.”
          <span class="note">A reminder to stay adaptive without losing form.</span>
        </figcaption>
      </figure>

      {/* 出口放在图下面，与左栏的徽章那几行齐平：右栏原本到图注就结束了，
          底下空一大块；把唯一的站外去处放进来，两栏的长度也就接上了。
          不做成按钮 —— 站点是克制的，按钮会打架。 */}
      <p class="exit">
        <a href="https://github.com/xiaomayi-ant" rel="noreferrer" target="_blank">
          到我的 GitHub 看看<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </p>
    </aside>
  </div>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 22rem);
    justify-content: space-between;
    gap: clamp(2rem, 6vw, 5rem);
    padding-top: var(--space-xl);
  }

  h1 {
    margin-top: var(--space-sm);
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    line-height: 1.5;
    text-wrap: balance;
  }

  /* 副标题用英文与 display 体的斜体：中文标题下面接一句英文，
     两种语言在同一块里各说各的，才不会读成同一句话的两遍 */
  .sub {
    margin-top: var(--space-sm);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--color-ink-soft);
  }

  .block {
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
  }

  h2 {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  /* 近来喜欢：三条，日期与类型压在标题下面一行，比并排更紧凑 */
  .recent {
    margin-top: var(--space-md);
    display: grid;
    gap: var(--space-md);
  }

  .recent a {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .when {
    display: block;
    margin-top: var(--space-2xs);
    color: var(--color-ink-faint);
  }

  .more {
    margin-top: var(--space-lg);
  }

  .more a {
    font-family: var(--font-display);
    color: var(--color-ink-faint);
  }

  .more a:hover {
    color: var(--color-ink);
  }

  .arrow {
    margin-left: 0.3em;
    font-size: 0.85em;
    vertical-align: 0.05em;
  }

  /* ── 徽章 ──
     发丝线圈出来的一枚，不填色、不加圆角到药丸那么圆 ——
     站点通篇只有发丝线和留白两种分隔手段，徽章沿用同一种。
     hover 时边线转成河蓝，是全站链接一致的那一下。 */
  .badge-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .badge-label {
    flex-shrink: 0;
    width: 2.5rem;
    color: var(--color-ink-faint);
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .badge {
    padding: 0.28em 0.85em;
    border: 1px solid var(--color-line);
    border-radius: 3px;
    color: var(--color-ink-soft);
    font-size: var(--text-sm);
    line-height: 1.6;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .badge:hover {
    border-color: var(--color-river);
    color: var(--color-ink);
  }

  /* 出口靠"推到底"来对齐，不靠固定间距去凑：它的位置本来由图的高度决定，
     和左栏落在哪儿毫无关系，对齐纯属碰运气。让右栏拉伸到与左栏同高，
     再把出口推到底，它就和左栏最后一行（读法）收在同一条线上。 */
  .side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  /* 出口顶上也压一条发丝线 —— 左栏用它分段，右栏跟着用同一种手段，
     两栏才读成一套版式，而不是一栏有结构、一栏在飘。 */
  .exit {
    margin: 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-line);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  /* 链接统一：正文里的链接走浮光下划线；徽章自己有边线，不参与。
     挂在整个网格上，因为出口现在在右栏。 */
  .about-grid a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .about-grid a:not(.badge) {
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .about-grid a:not(.badge):hover {
    background-size: 100% 1px;
  }

  /* 图不加边框圆角：它的纸底和页面的纸底是同一种白，画个框反而把它从页面上剪下来 */
  .figure {
    margin: 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--color-line);
  }

  .figure figcaption {
    margin-top: var(--space-md);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.6;
    color: var(--color-ink);
  }

  /* 注解跟着引言用衬线小字，不再借 .meta 的等宽全大写 ——
     等宽压在衬线引言下面太重，两种字体在一块两行的区域里打架 */
  .note {
    display: block;
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-ink-faint);
  }

  @media (max-width: 60rem) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .side {
      display: block;
    }

    .figure {
      max-width: 22rem;
    }

    .exit {
      margin-top: var(--space-xl);
    }
  }
</style>
