---
// 首页 — 艺术河流首屏 / 两个大号入口，各自带一列最新条目
import Base from '../layouts/Base.astro';
import ArtRiverHero from '../components/ArtRiverHero.astro';
import {
  getAllProjects,
  getAllResearch,
  articleUrl,
  projectUrl,
  formatDate,
} from '../lib/content';

// ── 入口下的条目列 ─────────────────────────────────────────
// Blog 列：三个 Content Collections 合并、排除 draft、按日期倒序取前 3 条。
const ROWS_PER_ENTRY = 3;

const blogRows = (await getAllResearch()).slice(0, ROWS_PER_ENTRY).map((entry) => ({
  date: formatDate(entry.data.pubDate),
  title: entry.data.title,
  href: articleUrl(entry),
}));

// Github 列：已发布的项目；不足 3 条的位置留占位行，等具体项目填进来。
const githubRows = (await getAllProjects()).slice(0, ROWS_PER_ENTRY).map((project) => ({
  date: formatDate(project.data.pubDate),
  title: project.data.title,
  href: projectUrl(project),
}));

const githubPlaceholders = Math.max(0, ROWS_PER_ENTRY - githubRows.length);

const entries = [
  {
    num: '01',
    title: 'Blog',
    desc: '思考、实验、技术文章和长期问题',
    href: '/blog',
    list: 'blog',
    rows: blogRows,
    placeholders: 0,
  },
  {
    num: '02',
    title: 'Github',
    desc: '正在构建的工具、系统和独立产品',
    href: '/projects',
    list: 'github',
    rows: githubRows,
    placeholders: githubPlaceholders,
  },
];
---

<Base
  title="Be water, my friend."
  description="关注智能系统、界面，以及人在技术中的判断。记录尚未定型的想法，也做可以被使用的东西。"
>
  <div class="home-flow" data-page-flow="continuous-no-dividers">
    <ArtRiverHero />

    <!-- 2. 大号入口 + 各自的条目列 -->
    <section class="entries" aria-label="站点入口">
      {
        entries.map(({ num, title, desc, href, list, rows, placeholders }) => (
          <div class="entry-col">
            <a class="entry" href={href}>
              <span class="entry-num meta">{num}</span>
              <span class="entry-body">
                <span class="entry-title">{title}</span>
                <span class="entry-desc">{desc}</span>
              </span>
              <span class="entry-dot" aria-hidden="true" />
            </a>

            <ul class="entry-list" data-entry-list={list} aria-label={`${title} 最新条目`}>
              {rows.map((row) => (
                <li>
                  <a class="row" href={row.href}>
                    <span class="row-date meta">{row.date}</span>
                    <span class="row-title">{row.title}</span>
                  </a>
                </li>
              ))}
              {Array.from({ length: placeholders }).map(() => (
                <li>
                  <span class="row row--empty" aria-hidden="true">
                    <span class="row-date meta">————</span>
                    <span class="row-title">待填充</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </div>
</Base>

<style>
  .home-flow {
    display: flow-root;
  }

  /* ── 大号入口 ── */
  .entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(3rem, 8vw, 7rem);
    margin-top: clamp(1.5rem, 3vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .entry {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    padding: var(--space-sm) var(--space-md);
    margin-inline: calc(var(--space-md) * -1);
    color: var(--color-ink);
    text-decoration: none;
    border: 0;
    border-radius: 1rem;
    transition: background-color var(--duration-slow) var(--ease-out);
  }

  .entry:hover {
    text-decoration: none;
    /* 不用分割线，也不要成片的蓝：只留一层刚好能读出"选中"的水色 */
    background-color: rgba(36, 107, 255, 0.014);
  }

  .entry-num {
    width: 2.5rem;
    flex-shrink: 0;
    color: #0000f2;
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .entry-desc {
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .entry:hover .entry-desc {
    color: var(--color-ink);
  }

  /* 阳黄光点：hover 时安静地出现 */
  .entry-dot {
    position: absolute;
    right: var(--space-md);
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sun);
    opacity: 0;
    transform: translateY(-50%) scale(0.5);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .entry:hover .entry-dot {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  /* ── 入口下的条目列：明确从属于上方入口，字号比入口小一档 ── */
  .entry-list {
    margin-top: var(--space-md);
    padding-left: calc(2.5rem + var(--space-lg));
  }

  .row {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
    padding-block: 0.42rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .row:hover {
    text-decoration: none;
  }

  .row-date {
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
  }

  .row-title {
    font-size: 0.9375rem;
    line-height: 1.6;
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .row:hover .row-title {
    background-size: 100% 1px;
  }

  .row--empty {
    color: var(--color-ink-faint);
  }

  .row--empty .row-title {
    background-image: none;
  }

  @media (max-width: 40rem) {
    .entries {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .entry-title {
      font-size: var(--text-2xl);
    }

    .entry-list {
      padding-left: var(--space-md);
    }

    .row {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
