---
// 首页 — 艺术河流首屏 / 大号入口 / 时间流
import Base from '../layouts/Base.astro';
import ArtRiverHero from '../components/ArtRiverHero.astro';
import { getAllResearch, TYPE_LABELS, articleUrl, formatDate } from '../lib/content';

// ── 时间流数据 ─────────────────────────────────────────────
// 从三个 Content Collections 读取（合并、排除 draft、按日期倒序取前 5 条）。
const stream = (await getAllResearch()).slice(0, 5).map((entry) => ({
  date: formatDate(entry.data.pubDate),
  title: entry.data.title,
  type: TYPE_LABELS[entry.collection].en.slice(0, -1).toUpperCase(), // Essays→ESSAY
  href: articleUrl(entry),
}));

const entries = [
  {
    num: '01',
    zh: '研究',
    en: 'RESEARCH',
    desc: '思考、实验、技术文章和长期问题',
    href: '/research',
  },
  {
    num: '02',
    zh: '项目',
    en: 'PROJECTS',
    desc: '正在构建的工具、系统和独立产品',
    href: '/projects',
  },
];
---

<Base
  title="Be water, my friend."
  description="关注智能系统、界面，以及人在技术中的判断。记录尚未定型的想法，也做可以被使用的东西。"
>
  <ArtRiverHero />

  <!-- 2. 大号排印入口 -->
  <section class="entries" aria-label="站点入口">
    {
      entries.map(({ num, zh, en, desc, href }) => (
        <a class="entry" href={href}>
          <span class="entry-num meta">{num}</span>
          <span class="entry-body">
            <span class="entry-title">
              {zh}
              <span class="entry-en meta">{en}</span>
            </span>
            <span class="entry-desc">{desc}</span>
          </span>
          <span class="entry-dot" aria-hidden="true" />
        </a>
      ))
    }
  </section>

  <!-- 3. 时间流 -->
  <section class="stream" aria-labelledby="stream-title">
    <h2 id="stream-title" class="stream-heading meta">时间流 · STREAM</h2>
    <ul>
      {
        stream.map(({ date, title, type, href }) => (
          <li>
            <a href={href} class="stream-item">
              <span class="stream-date meta">{date}</span>
              <span class="stream-title">{title}</span>
              <span class="stream-type meta">{type}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  /* ── 大号入口 ── */
  .entries {
    display: flex;
    flex-direction: column;
  }

  .entry {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    color: var(--color-ink);
    text-decoration: none;
    border-top: 1px solid var(--color-line);
  }

  .entry:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .entry:hover {
    text-decoration: none;
  }

  /* 下划线流动：天蓝水线从左向右漫过 */
  .entry::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--color-river);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .entry:hover::after {
    transform: scaleX(1);
  }

  .entry-num {
    width: 2.5rem;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .entry:hover .entry-num {
    color: var(--color-river);
  }

  .entry-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .entry-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: 1.2;
    display: flex;
    align-items: baseline;
    gap: var(--space-md);
  }

  .entry-desc {
    color: var(--color-ink-soft);
    font-size: var(--text-base);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .entry:hover .entry-desc {
    color: var(--color-ink);
  }

  /* 阳黄光点：hover 时安静地出现 */
  .entry-dot {
    position: absolute;
    right: 0;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-sun);
    opacity: 0;
    transform: translateY(-50%) scale(0.5);
    transition:
      opacity var(--duration-slow) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .entry:hover .entry-dot {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  /* ── 时间流 ── */
  .stream {
    margin-top: var(--space-2xl);
    max-width: var(--measure-wide);
  }

  .stream-heading {
    margin-bottom: var(--space-lg);
  }

  .stream-item {
    display: grid;
    grid-template-columns: 7.5rem 1fr auto;
    align-items: baseline;
    gap: var(--space-lg);
    padding-block: var(--space-sm);
    color: var(--color-ink);
    text-decoration: none;
  }

  .stream-item:hover {
    text-decoration: none;
  }

  .stream-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .stream-item:hover .stream-title {
    background-size: 100% 1px;
  }

  .stream-type {
    color: var(--color-ink-faint);
  }

  @media (max-width: 40rem) {
    .stream-item {
      grid-template-columns: 6.5rem 1fr;
    }

    .stream-type {
      display: none;
    }

    .entry-title {
      font-size: var(--text-2xl);
    }
  }
</style>
