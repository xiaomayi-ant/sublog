---
// 首页 — 气质（首屏引言与问句）→ 人（一句身份）→ 作品（最近写的）→ 收尾
import Base from '../layouts/Base.astro';
import ArtRiverHero from '../components/ArtRiverHero.astro';
import LifeTimeline from '../components/LifeTimeline.astro';
import { getAllResearch, articleUrl, formatDate } from '../lib/content';

// 最近写的：三个 collection 合并、排除 draft、按日期倒序。
// 用绝对日期而不是"7 天前"——站点是静态构建的，相对时间会停在构建那一刻。
const recent = (await getAllResearch()).slice(0, 3).map((entry) => ({
  date: formatDate(entry.data.pubDate),
  title: entry.data.title,
  href: articleUrl(entry),
}));

---

<Base
  title="Be water, my friend."
  description="sumoer 的个人站：AI 的 Harness、模型应用，以及判断它们有没有变好的评估。"
  footer="signature"
>
  <div class="home-flow" data-page-flow="continuous-no-dividers">
    <ArtRiverHero />

    <div class="home-tail">
      <section class="recent" aria-label="最近写的" data-home-index="recent-writing">
        <ul>
          {
            recent.map(({ date, title, href }) => (
              <li>
                <a class="row" href={href}>
                  <span class="row-date meta">{date}</span>
                  <span class="row-title">{title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <LifeTimeline />
    </div>
  </div>
</Base>

<style>
  .home-flow {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    background: var(--color-bg);
  }

  /* 第二屏：吃掉首屏之后的全部余量，内容居中。
     余量均分到上下两侧，就不会像原来那样时间线和页脚之间空出一大块、
     而时间线又紧贴在最近写的下面。 */
  .home-tail {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    justify-content: center;
  }

  /* 最近写的：没有小标题、没有编号、没有分类，只有日期和标题 */
  .recent {
    position: relative;
    z-index: 1;
  }

  .row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--space-md);
    padding-block: 0.55rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .row:hover {
    text-decoration: none;
  }

  .row-date {
    color: var(--color-ink-faint);
  }

  /* 顺便补上字号阶梯里 39px 与 17px 之间那一档 */
  .row-title {
    position: relative;
    /* 收缩到文字宽：它是网格项，默认会撑满整列，
       浮光居中就会落在文字右边的空白里 */
    justify-self: start;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  /* 悬停时亮起来的是一小段浮光，不是一条贯通的线。
     用金色而不是河流的青：河流是这一页的底色，下划线再用它就成了背景的一部分；
     阳光是落在东西上的，才有"被照到"的意思。
     --color-sun 的 1.58:1 在别处是缺陷（承载不了文字），在"弱的浮光"上恰好合适。
     短（3rem）、细（1px）、两端消隐、从中间绽开 —— 让它读作一道反光而不是一条边框。 */
  .row-title::after {
    position: absolute;
    bottom: -0.16em;
    left: 50%;
    /* 至少 20rem，且不短于标题本身。最长的标题 242px，浮光 320px ——
       它比字长，才读作"光落在这一行上"，而不是一小截下划线。
       3rem 那一版太短，几乎起不到反馈作用。 */
    width: max(20rem, 100%);
    height: 1px;
    content: '';
    background-image: linear-gradient(
      90deg,
      transparent 0%,
      rgba(245, 200, 91, 0.5) 22%,
      rgba(232, 166, 60, 0.95) 50%,
      rgba(245, 200, 91, 0.5) 78%,
      transparent 100%
    );
    background-size: 180% 100%;
    background-position: 0% 50%;
    box-shadow: 0 0 6px 0 rgba(232, 166, 60, 0.34);
    opacity: 0;
    transform: translateX(-50%) scaleX(0.2);
    transform-origin: center;
    transition:
      transform var(--duration-slow) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .row:hover .row-title::after,
  .row:focus-visible .row-title::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1);
    /* 亮芯在这一小段里缓慢游走，光才是"浮"的 */
    animation: light-drift 7s linear infinite;
  }

  @keyframes light-drift {
    from {
      background-position: 0% 50%;
    }

    to {
      background-position: -180% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-title::after {
      transition: opacity var(--duration-fast) var(--ease-out);
      transform: translateX(-50%) scaleX(1);
    }

    .row:hover .row-title::after,
    .row:focus-visible .row-title::after {
      animation: none;
    }
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      gap: var(--space-sm);
    }
  }
</style>
