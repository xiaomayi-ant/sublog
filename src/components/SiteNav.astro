---
// SiteNav — 左上 SUMOER，右侧极简导航（研究 / Projects / About）
const links = [
  { href: '/research', label: '研究', en: 'Research' },
  { href: '/projects', label: '项目', en: 'Projects' },
  { href: '/about', label: '关于', en: 'About' },
];
const current = Astro.url.pathname;
---

<header class="site-nav site-shell">
  <a class="brand" href="/">SUMOER</a>
  <nav aria-label="主导航">
    <ul>
      {links.map(({ href, label, en }) => (
        <li>
          <a
            href={href}
            aria-current={current.startsWith(href) ? 'page' : undefined}
          >
            {label}
            {en && <span class="nav-en" aria-hidden="true">{en}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: var(--space-lg);
  }

  .brand {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
    color: var(--color-ink);
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: var(--space-lg);
  }

  nav a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  nav a:hover {
    color: var(--color-river);
    text-decoration: none;
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
    box-shadow: inset 0 -2px 0 var(--color-sun);
  }

  .nav-en {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  @media (max-width: 40rem) {
    .nav-en {
      display: none;
    }
  }
</style>
