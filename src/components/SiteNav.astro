---
// SiteNav — 左上 SUMOER，右侧极简导航（纯英文）
// Graph 与 Albums 紧跟 Blog：两者都是同一批文章的另一种读法 ——
// 一个按概念连起来，一个按月收成册 —— 不是独立的内容。
const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/albums', label: 'Albums' },
  { href: '/graph', label: 'Graph' },
  { href: '/projects', label: 'Github' },
  { href: '/about', label: 'About' },
];

// 尾斜杠归一化后再判断：首页要求精确匹配，其余允许子路由（/blog/harness/... 仍高亮 Blog）
const pathname = Astro.url.pathname.replace(/(.)\/$/, '$1');
const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-nav site-shell">
  <a class="brand" href="/">SUMOER</a>
  <nav aria-label="主导航">
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-block: var(--space-lg);
  }

  .brand {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    color: var(--color-ink);
    text-decoration: none;
  }

  ul {
    display: flex;
    gap: clamp(1.5rem, 3.5vw, 2.75rem);
  }

  nav a {
    position: relative;
    display: inline-block;
    padding-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 400;
    letter-spacing: 0.005em;
    color: var(--color-ink-soft);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  /* 选中态与 hover 共用同一条水线：hover 时从左漫过，选中时常驻 */
  nav a::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.5px;
    content: '';
    background: var(--color-river);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  nav a:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  nav a:hover::after,
  nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  nav a[aria-current='page'] {
    color: var(--color-ink);
    font-style: italic;
  }

  @media (max-width: 40rem) {
    ul {
      gap: 1.25rem;
    }

    nav a {
      font-size: 1rem;
    }
  }
</style>
