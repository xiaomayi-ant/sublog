---
// ArticleRelations — 文章收尾的知识图谱区：局部小图 → 涉及的概念 → 相关文章。
// 数据全部来自构建期的 data/graph.json；产物里没有这篇文章（或根本没有产物）时整块不渲染，
// 文章页退回到干净的正文 + 返回链接。
import ConceptGraph from './ConceptGraph.astro';
import type { ResearchEntry } from '../lib/content';
import { getArticleRelations } from '../lib/graph';

interface Props {
  entry: ResearchEntry;
}

const { entry } = Astro.props;
const relations = await getArticleRelations(entry.collection, entry.id);
const hasGraph = relations.concepts.length > 0;
---

{
  hasGraph && (
    <section class="relations" data-article-relations aria-label="相关概念与文章">
      <ConceptGraph
        nodes={relations.neighbors.nodes}
        edges={relations.neighbors.edges}
        focusId={`article:${entry.collection}/${entry.id}`}
        height={320}
        label={`「${entry.data.title}」的概念图谱`}
      />

      <p class="concept-chips">
        {relations.concepts.map((concept) => (
          <a class="chip meta" href={concept.href}>
            {concept.name}
          </a>
        ))}
      </p>

      {relations.related.length > 0 && (
        <ul class="related-list">
          {relations.related.map((article) => (
            <li class="related-item">
              <a class="related-title" href={article.href}>
                {article.title}
              </a>
              <span class="related-shared meta">{article.sharedCount} 个共同概念</span>
            </li>
          ))}
        </ul>
      )}
    </section>
  )
}

<style>
  .relations {
    margin-top: var(--space-2xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-line);
  }

  /* 概念 chips：与文章头部的 tag 链接同款语气，hover 才见河蓝 */
  .concept-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
    margin-top: var(--space-lg);
  }

  .chip {
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .chip:hover {
    color: var(--color-river);
  }

  /* 相关文章：仿 tags 页的列表，标题带下划线浮光 */
  .related-list {
    margin-top: var(--space-lg);
  }

  .related-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-block: var(--space-sm);
  }

  .related-title {
    color: var(--color-ink);
    font-family: var(--font-serif);
    text-decoration: none;
    background-image: linear-gradient(var(--color-river), var(--color-river));
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    transition: background-size var(--duration-slow) var(--ease-out);
  }

  .related-title:hover {
    background-size: 100% 1px;
  }

  .related-shared {
    flex-shrink: 0;
    color: var(--color-ink-faint);
  }
</style>
