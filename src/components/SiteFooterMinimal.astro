---
// SiteFooterMinimal — 文章页的精简收尾：只留最底那条工具行（RSS + ©）。
//
// 完整页脚的三栏是站点的签名，属于索引页；文章读完之后读者要的是离开或继续，
// 不是再看一遍导航。样式语言与 SiteFooter 的工具行保持一致，只是没了上面的部分。
const year = new Date().getUTCFullYear();
---

<footer class="site-foot-minimal site-shell" data-footer="minimal">
  <div class="foot-utility">
    <p><a href="/rss.xml">RSS</a></p>
    <p>© {year}</p>
  </div>
</footer>

<style>
  .site-foot-minimal {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: var(--space-lg);
  }

  /* 与 SiteFooter 同一条发丝线收尾 —— 两个页脚共用这套语言 */
  .foot-utility {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-line);
    color: var(--color-ink-faint);
    font-size: var(--text-xs);
  }

  .foot-utility a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .foot-utility a:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }
</style>
