---
// HomeRiver — the tuned lab river, present from the first frame and shared by the full home flow.
---

<div
  class="home-river-field"
  data-home-river="locked-preset"
  data-river-entry="present-from-first-frame"
  data-river-continuity="hero-to-entries"
  data-bend="1.3"
  data-width="1.26"
  data-flow="1"
  data-layers="8"
  aria-hidden="true"
>
  <div class="home-river-viewport">
    <canvas id="home-river-canvas" class="home-river-canvas" aria-hidden="true"></canvas>
    <div class="home-river-sun"></div>
    <div class="home-river-quiet"></div>
  </div>
</div>

<script>
  import {
    createRiverRenderer,
    HOME_RIVER_PRESET,
  } from '../lib/riverRenderer.mjs';

  const canvas = document.querySelector<HTMLCanvasElement>('#home-river-canvas');
  const homeFlow = document.querySelector<HTMLElement>('.home-flow');

  if (canvas && homeFlow) {
    const flow = homeFlow;
    const progress = () => {
      const bounds = flow.getBoundingClientRect();
      const travel = Math.max(1, bounds.height - window.innerHeight);
      return Math.min(1, Math.max(0, -bounds.top / travel));
    };

    createRiverRenderer({
      canvas,
      initialState: HOME_RIVER_PRESET,
      getProgress: progress,
      getOpacity: (value: number) => 1 - value * 0.58,
      observeElement: flow,
      yOffset: -0.08,
    });
  }
</script>

<style>
  .home-river-field {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: 0;
    width: 100vw;
    pointer-events: none;
    overflow: clip;
  }

  .home-river-viewport {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    overflow: hidden;
  }

  .home-river-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-river-sun,
  .home-river-quiet {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .home-river-sun {
    background:
      linear-gradient(
        136deg,
        rgba(255, 207, 96, 0.13),
        rgba(255, 228, 157, 0.035) 24%,
        transparent 48%
      ),
      radial-gradient(circle at 9% 4%, rgba(255, 222, 142, 0.19), transparent 25%);
    mix-blend-mode: multiply;
  }

  .home-river-quiet {
    background:
      radial-gradient(
        ellipse 34% 43% at 19% 35%,
        rgba(255, 255, 255, 0.88) 0%,
        rgba(255, 255, 255, 0.66) 44%,
        rgba(255, 255, 255, 0.12) 72%,
        transparent 100%
      ),
      linear-gradient(to bottom, transparent 70%, rgba(255, 255, 255, 0.3) 100%);
  }

  @media (max-width: 44rem) {
    .home-river-viewport {
      position: absolute;
      top: 0;
      height: min(48rem, 100svh);
    }

    .home-river-canvas {
      opacity: 0.72;
    }

    .home-river-quiet {
      background:
        radial-gradient(
          ellipse 70% 44% at 32% 32%,
          rgba(255, 255, 255, 0.92) 0%,
          rgba(255, 255, 255, 0.68) 52%,
          transparent 100%
        ),
        linear-gradient(to bottom, transparent 58%, #fff 94%);
    }
  }
</style>
