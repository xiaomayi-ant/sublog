---
// HomeRiver — the tuned lab river, present from the first frame and shared by the full home flow.
---

<div
  class="home-river-field"
  data-home-river="locked-preset"
  data-river-entry="present-from-first-frame"
  data-river-scope="hero-only"
  data-bend="1.3"
  data-width="1.26"
  data-flow="1"
  data-layers="8"
  aria-hidden="true"
>
  <div class="home-river-viewport">
    <canvas id="home-river-canvas" class="home-river-canvas" aria-hidden="true"></canvas>
    <div class="home-river-quiet"></div>
  </div>
</div>

<script>
  import {
    createRiverRenderer,
    HOME_RIVER_PRESET,
  } from '../lib/riverRenderer.mjs';

  const canvas = document.querySelector<HTMLCanvasElement>('#home-river-canvas');

  if (canvas) {
    // 河固定在首屏，形态不再随滚动变化 —— getProgress 保持默认的 0。
    // 它跟着首屏一起滚走，而不是被钉在视口顶部让页面从背后滑过。
    //
    // 下面这组数值是在 /lab/fluid-river 上逐项拨出来的，不是推算的。
    // 河道几何完全不受它们影响 —— 它们只改内里填什么、以及哪里起浪。
    createRiverRenderer({
      canvas,
      initialState: HOME_RIVER_PRESET,
      yOffset: -0.08,
      // 内里换成流体场：域扭曲场随时间演化，纹理被拉伸、卷起、再合上。
      // 这是河原来那套（虚线沿固定路径平移，一维位移）做不到的。
      fluidInterior: true,
      fluidStrength: 0.96,
      washOpacity: 0.94,
      // 纤维压到三成：原来的 50 条太密，读起来是一把梳齿而不是水纹。
      // 条数少了就把每条调浓一点，免得纹路整个消失。
      fiberDensity: 0.32,
      fiberOpacity: 1.4,
      // 弯道二次流：表层水涌向外岸。只在弯得够急处起浪，直河段保持平静。
      bankWave: 0.32,
    });
  }
</script>

<style>
  .home-river-field {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: 0;
    width: 100vw;
    pointer-events: none;
    overflow: clip;
  }

  /* 不再 sticky：河待在首屏这个盒子里，随它一起滚走 */
  .home-river-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .home-river-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-river-quiet {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* 原来这里还有一个覆盖标题区的白色椭圆（0.88 alpha），用来给文字腾出可读的底。
     实测那一带河流本身就只有 rgb(231,247,251)，墨压上去是 10.17:1 —— 白椭圆
     换来的 1 点对比度，代价是把河的左半边洗掉了。只保留底部的收边。 */
  .home-river-quiet {
    background: linear-gradient(to bottom, transparent 70%, rgba(255, 255, 255, 0.3) 100%);
  }

  @media (max-width: 44rem) {
    .home-river-viewport {
      height: 100%;
    }

    .home-river-canvas {
      opacity: 0.72;
    }

    .home-river-quiet {
      background: linear-gradient(to bottom, transparent 58%, #fff 94%);
    }
  }
</style>
