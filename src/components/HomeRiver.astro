---
// HomeRiver — the tuned lab river, present from the first frame and shared by the full home flow.
---

<div
  class="home-river-field"
  data-home-river="locked-preset"
  data-river-entry="present-from-first-frame"
  data-river-scope="hero-only"
  data-bend="1.3"
  data-width="1.26"
  data-flow="1"
  data-layers="8"
  aria-hidden="true"
>
  <div class="home-river-viewport">
    <canvas id="home-river-canvas" class="home-river-canvas" aria-hidden="true"></canvas>
    <div class="home-river-quiet"></div>
  </div>
</div>

<script>
  import {
    createRiverRenderer,
    HOME_RIVER_PRESET,
  } from '../lib/riverRenderer.mjs';

  const canvas = document.querySelector<HTMLCanvasElement>('#home-river-canvas');

  if (canvas) {
    // 河固定在首屏，形态不再随滚动变化 —— getProgress 保持默认的 0。
    // 它跟着首屏一起滚走，而不是被钉在视口顶部让页面从背后滑过。
    createRiverRenderer({
      canvas,
      initialState: HOME_RIVER_PRESET,
      yOffset: -0.08,
    });
  }
</script>

<style>
  .home-river-field {
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: 0;
    width: 100vw;
    pointer-events: none;
    overflow: clip;
  }

  /* 不再 sticky：河待在首屏这个盒子里，随它一起滚走 */
  .home-river-viewport {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .home-river-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-river-quiet {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* 原来这里还有一个覆盖标题区的白色椭圆（0.88 alpha），用来给文字腾出可读的底。
     实测那一带河流本身就只有 rgb(231,247,251)，墨压上去是 10.17:1 —— 白椭圆
     换来的 1 点对比度，代价是把河的左半边洗掉了。只保留底部的收边。 */
  .home-river-quiet {
    background: linear-gradient(to bottom, transparent 70%, rgba(255, 255, 255, 0.3) 100%);
  }

  @media (max-width: 44rem) {
    .home-river-viewport {
      height: 100%;
    }

    .home-river-canvas {
      opacity: 0.72;
    }

    .home-river-quiet {
      background: linear-gradient(to bottom, transparent 58%, #fff 94%);
    }
  }
</style>
