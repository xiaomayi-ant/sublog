---
// ArtRiverHero — editorial title and questions over the mathematical river.
import HomeRiver from './HomeRiver.astro';
---

<section
  class="shore-hero"
  aria-labelledby="home-title"
  data-surface="unified-page-bg"
  data-color-focus="clear-water"
  data-motion-rhythm="material-flow-scroll-bend"
  data-type-system="editorial-serif-sans"
  data-intro-motion="per-load-word-reveal"
>
  <HomeRiver />

  <div class="hero-frame">
    <div class="hero-copy">
      <h1
        id="home-title"
        aria-label="Be water, my friend."
        data-intro-state="playing"
        data-water-color="liquid-glass"
        data-friend-color="sun"
      >
        <span class="intro-line intro-line--water" aria-hidden="true">
          <span class="intro-be" style="--word-delay: 120ms">Be</span>
          <span class="intro-space">&nbsp;</span>
          <span class="intro-water" style="--word-delay: 620ms"
            ><span class="intro-water-fill" data-text="water"
              >water<canvas class="intro-water-fluid" aria-hidden="true"></canvas></span
          ></span
          ><span class="intro-comma" style="--word-delay: 620ms">,</span>
        </span>
        <span class="intro-line intro-line--friend" aria-hidden="true">
          <span class="intro-letter" style="--letter-delay: 1180ms">m</span>
          <span class="intro-letter" style="--letter-delay: 1330ms">y</span>
          <span class="intro-space">&nbsp;</span>
          <span class="intro-letter" style="--letter-delay: 1480ms">f</span>
          <span class="intro-letter" style="--letter-delay: 1630ms">r</span>
          <span class="intro-letter" style="--letter-delay: 1780ms">i</span>
          <span class="intro-letter" style="--letter-delay: 1930ms">e</span>
          <span class="intro-letter" style="--letter-delay: 2080ms">n</span>
          <span class="intro-letter" style="--letter-delay: 2230ms">d</span>
          <span class="intro-letter" style="--letter-delay: 2380ms">.</span>
        </span>
      </h1>

    </div>

    <div class="hero-questions" data-stream="typewriter" data-stream-form="plain-lines">
      <p class="question">
        <span class="type type--zh">在智力方面，人类和AI的区别是什么？</span>
        <span class="type type--en">In terms of intelligence, what separates a human from an AI?</span>
      </p>
      <p class="question">
        <span class="type type--zh">AI目前的边界是什么？</span>
        <span class="type type--en">Where are the boundaries of AI today?</span>
      </p>
    </div>

  </div>
</section>

<style>
  /* 首屏不再满幅出血：河流已经是独立的满幅图层，这里只剩文字。
     让它跟着 .site-shell 的盒子走，标题的左边缘才和导航、入口区共用一条线 ——
     两个容器各自算宽度（64rem vs 76rem）时，最大的那个元素反而是唯一不对齐的。 */
  /* 不要 overflow:hidden —— 河的图层是 inset:0 calc(50% - 50vw) 的满幅出血，
     一裁就被剪到内容宽。纵向由这个盒子限定即可，横向必须放它出去。 */
  /* 整整一屏，减去导航 —— 原来封在 49rem 是为了大屏上别拉太长，
     但那也意味着屏幕一高，第二屏的内容就从下边缘探头进来，首屏不再是"一屏"。 */
  .shore-hero {
    position: relative;
    min-height: calc(100svh - 5.25rem);
    background: transparent;
    border: 0;
  }

  .hero-frame {
    position: relative;
    display: grid;
    min-height: inherit;
    padding-block: clamp(2rem, 4vh, 3rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    align-self: start;
    width: min(100%, 34rem);
    padding-top: clamp(1rem, 6vh, 4rem);
  }

  h1 {
    color: var(--color-ink);
    font-family: "Iowan Old Style", Baskerville, "Times New Roman", serif;
    font-size: clamp(4.25rem, 6.62vw, 5.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .intro-line {
    display: block;
    width: max-content;
    max-width: 100%;
    transform-origin: left center;
  }

  .intro-line--water {
    font-style: italic;
    font-weight: 500;
  }

  /* Y1：纯阳黄。--color-sun 在 tokens.css 里被标注为"永不承载文字"（1.58:1），
     这里是明知故用的例外 —— 标题是 88px 的大字且不承载信息（aria-label 已给出
     完整句子），观感优先。实测数据见 docs/。 */
  .intro-be {
    display: inline-block;
    color: var(--color-sun);
  }

  .intro-water,
  .intro-comma {
    display: inline-block;
  }

  /* 逗号跟着 Be 走，不再是水青 —— Y1 里整句非 water 的部分是同一个金 */
  .intro-comma {
    color: var(--color-sun);
  }

  .intro-water-fill {
    position: relative;
    display: inline-block;
    /* 字身几乎全透（合成后 #ccebf0，1.25:1）；字形交给边缘去撑。
       原来这里有四种阴影色（含一档天蓝 141,203,255），一个词里就有七种色相 ——
       全部并回青色轴，只留：上缘白高光、一侧青色折射、下方投影。 */
    color: rgba(74, 184, 202, 0.28);
    text-shadow:
      -0.015em -0.016em 0 rgba(255, 255, 255, 0.95),
      0.016em 0.004em 0.01em rgba(94, 214, 224, 0.6),
      0 0.06em 0.55em rgba(58, 150, 176, 0.3);
    animation: water-surface 5.5s ease-in-out infinite;
    will-change: transform;
  }

  .intro-water-fill::before {
    position: absolute;
    inset: 0;
    content: attr(data-text);
    pointer-events: none;
    color: transparent;
    background-image: linear-gradient(
      104deg,
      transparent 28%,
      rgba(58, 164, 186, 0.5) 42%,
      rgba(150, 232, 240, 0.72) 50%,
      rgba(58, 164, 186, 0.42) 58%,
      transparent 72%
    );
    background-size: 260% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    animation: water-flow 9s linear infinite;
    will-change: background-position;
  }

  /* 字身里的流体。放在 .intro-water-fill 内部而不是外面：那个元素带着
     water-surface 的 transform，做了包含块，画布才会跟着字一起晃。 */
  .intro-water-fluid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* 接管成功才让位。字身的填充色和那道扫光交给流体，
     但三层 text-shadow 留着 —— 边缘高光才是"玻璃"的来源，
     而且 text-shadow 不受 color: transparent 影响。 */
  .intro-water-fill[data-fluid-glyph='on'] {
    color: transparent;
  }

  .intro-water-fill[data-fluid-glyph='on']::before {
    display: none;
  }

  /* 减重：700 字重 × 85px × 满彩度赭墨曾是整页最重的元素，与"轻灵"直接冲突。
     大字的对比度标准是 3.0，这里 7.31:1 仍有两倍余量。正文的 --color-ink 不动。 */
  .intro-line--friend {
    color: var(--color-sun);
    font-weight: 500;
    /* 浮现的起点与落点。落点必须跟这一行的实际字色一致，否则字会落到别的颜色上。
       起点用更淡的一档金，糊团才和落点同族 —— 用赭墨那档灰会显得脏。 */
    --intro-reveal-from: #f9e2ab;
    --intro-reveal-to: var(--color-sun);
  }

  .intro-letter {
    display: inline-block;
  }

  h1[data-intro-state='playing'] .intro-be,
  h1[data-intro-state='playing'] .intro-water,
  h1[data-intro-state='playing'] .intro-comma {
    animation: intro-word-in 420ms var(--ease-out) var(--word-delay) both;
  }

  h1[data-intro-state='playing'] .intro-letter {
    animation: intro-letter-in 300ms var(--ease-out) var(--letter-delay) both;
  }

  /* 无背景板，就是一块文字；左边缘与标题对齐 */
  .hero-questions {
    position: relative;
    z-index: 2;
    justify-self: start;
    align-self: start;
    width: max-content;
    max-width: min(100%, 46rem);
    margin-top: clamp(2.5rem, 6vh, 4.5rem);
    /* 不是 --color-ink-soft：这两行压在河上而不是白底上，同一个 alpha
       混进河面会掉一档对比度（4.84 → 3.81）。理由见 tokens.css。 */
    color: var(--color-ink-on-water);
  }

  .question + .question {
    margin-top: 1.4rem;
  }

  .type {
    display: block;
    /* content-box：动画写的是文字宽度，光标的边框才不会吃掉末尾字符 */
    box-sizing: content-box;
    width: max-content;
    max-width: 100%;
    overflow: hidden;
    white-space: nowrap;
    border-right: 2px solid transparent;
  }

  .type--zh {
    font-family: var(--font-sans);
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.85;
    letter-spacing: 0.02em;
  }

  /* 等宽是工程师的方言，和"思考 AI"的定位相斥；换回编辑体斜体，
     它和标题同源，读作同一句话的另一种写法，而不是第二个问题。 */
  .type--en {
    /* 原来是 --color-ink-faint（0.46）：白底上就只有 2.48:1，压到河上 2.22:1。
       它比中文行淡这件事仍然保留，但改由 0.82 这一档承担 —— 层次主要靠
       斜体编辑体和更小的字号，不必再靠把字淡到读不清。 */
    color: var(--color-ink-on-water-faint);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.88rem, 1vw, 0.96rem);
    letter-spacing: 0;
    line-height: 1.85;
  }

  /* 光标只属于"正在敲的那一行"，还没轮到的行不该先亮着一个方块 */
  .hero-questions[data-stream-state='playing'] .type[data-typed='typing'] {
    border-right-color: currentColor;
  }

  .hero-questions[data-stream-state='playing'] .type[data-typed='done'] {
    border-right-color: transparent;
    animation: none;
  }

  .hero-questions[data-stream-state='playing'] .type--last[data-typed='done'] {
    border-right-color: currentColor;
    animation: caret-blink 1.06s steps(1) infinite;
  }

  @keyframes type-in {
    from {
      width: 0;
    }

    to {
      width: var(--type-width);
    }
  }

  @keyframes caret-blink {
    0%,
    49% {
      border-right-color: currentColor;
    }

    50%,
    100% {
      border-right-color: transparent;
    }
  }

  @keyframes intro-word-in {
    from {
      opacity: 0;
      transform: translate3d(0, 0.16em, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes water-flow {
    from {
      background-position: 0% 50%;
    }

    to {
      background-position: -260% 50%;
    }
  }

  @keyframes water-surface {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }

    35% {
      transform: translate3d(0, -0.012em, 0) scale(1.004, 0.988);
    }

    70% {
      transform: translate3d(0, 0.014em, 0) scale(0.997, 1.014);
    }
  }

  /* 逐字浮现。
     真正制造"变化感"的不是位移也不是淡入，是 blur 把字糊成一团、再收拢成字形
     的那个过程 —— 单独的逐字淡入几乎读不出来。所以模糊量是这个动效的主体，
     不是副作用。

     但那团模糊的颜色不该写死。起点色和落点色都走自定义属性，任何容器都能
     覆盖它们；不覆盖时退回赭墨那一档。详见 docs/intro-reveal.md。 */
  @keyframes intro-letter-in {
    from {
      opacity: 0;
      color: var(--intro-reveal-from, var(--color-ink-mist));
      filter: blur(var(--intro-reveal-blur, 3px));
      transform: translate3d(0, 0.18em, 0);
    }

    /* 颜色要在最糊的那一段保持住。
       和模糊同步收敛的话，到 190ms 时颜色已经基本变回落点色 —— 糊团的颜色
       根本来不及被看见，那"任意颜色"就是个空参数。实测过才发现这一点。 */
    58% {
      color: var(--intro-reveal-from, var(--color-ink-mist));
    }

    to {
      opacity: 1;
      color: var(--intro-reveal-to, var(--color-ink));
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 58rem) {
    .hero-frame {
      width: min(100% - 3rem, 76rem);
    }

    h1 {
      font-size: clamp(3.6rem, 8vw, 5.5rem);
    }
  }

  @media (max-width: 44rem) {
    .shore-hero {
      min-height: min(43rem, calc(100svh - 4rem));
    }

    .hero-frame {
      width: min(100% - 2.5rem, 34rem);
      padding-block: 4rem 2.5rem;
    }

    .hero-copy {
      width: 100%;
      padding-top: 0;
    }

    h1 {
      font-size: clamp(3.65rem, 17vw, 5.4rem);
    }

    .hero-questions {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1[data-intro-state] .intro-line,
    h1[data-intro-state] .intro-be,
    h1[data-intro-state] .intro-water,
    h1[data-intro-state] .intro-comma,
    h1[data-intro-state] .intro-letter {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }

    .intro-water-fill,
    .intro-water-fill::before {
      animation: none;
    }

    .type {
      width: auto;
      border-right-color: transparent;
      animation: none;
    }
  }
</style>

<script>
  import { paceLines } from '../lib/typewriter.mjs';
  import { createFluidGlyph } from '../lib/fluidGlyph.mjs';
  import { WASH_LADDER } from '../lib/riverRenderer.mjs';

  // 「water」这个字身里也盛着水，用的是和河、和 404 同一个流体场与同一条色阶。
  //
  // 只接管填充：字身的颜色和那道扫光让位，三层 text-shadow 留着 —— 边缘高光
  // 才是"玻璃"的来源。接管失败（拿不到 WebGL / 着色器编译不过）时什么都不做，
  // 页面回到原来那套透明字身 + 扫光，一行都不必改。
  const waterFill = document.querySelector<HTMLElement>('.intro-water-fill');
  const waterCanvas = waterFill?.querySelector<HTMLCanvasElement>('.intro-water-fluid');

  if (waterFill && waterCanvas) {
    const handle = createFluidGlyph({
      canvas: waterCanvas,
      source: waterFill,
      palette: {
        shallow: WASH_LADDER[0].rgb,
        mid: WASH_LADDER[1].rgb,
        deep: WASH_LADDER[2].rgb,
      },
      // 字比 404 那个小得多，高光收敛一些，否则一个词里全是亮斑
      sheen: 0.7,
    });
    if (handle?.ok) waterFill.dataset.fluidGlyph = 'on';
  }

  const questions = document.querySelector<HTMLElement>('.hero-questions');
  const typeMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (questions && !typeMotion.matches) {
    const lines = [...questions.querySelectorAll<HTMLElement>('.type')];
    const range = document.createRange();

    // 量文字本身的宽度：.type 是块级元素，scrollWidth 会给出整栏宽，光标会跑过头
    const measured = lines.map((line) => {
      range.selectNodeContents(line);
      return {
        line,
        width: Math.ceil(range.getBoundingClientRect().width),
        characters: (line.textContent ?? '').trim().length,
      };
    });

    // 排期只依赖像素宽度，中英文因此以同一速度推进（见 lib/typewriter.mjs）
    const plans = paceLines(measured);

    measured.forEach(({ line, width, characters }, index) => {
      if (characters === 0) return;
      const { delay, duration, steps } = plans[index];

      line.style.setProperty('--type-width', `${width}px`);
      line.style.animation = `type-in ${duration}ms steps(${steps}) ${delay}ms both`;
      if (index === lines.length - 1) line.classList.add('type--last');

      line.addEventListener('animationstart', () => {
        line.dataset.typed = 'typing';
      }, { once: true });

      line.addEventListener(
        'animationend',
        () => {
          line.dataset.typed = 'done';
          line.style.animation = '';
          line.style.removeProperty('--type-width');
        },
        { once: true },
      );
    });

    questions.dataset.streamState = 'playing';
  }
</script>
