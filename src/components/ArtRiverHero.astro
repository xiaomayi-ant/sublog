---
// ArtRiverHero — portrait watercolor artwork with an editorial copy column.
---

<section class="shore-hero" aria-labelledby="home-title">
  <div class="hero-frame">
    <div class="hero-copy">
      <p class="hero-kicker meta">Water / Personal field notes</p>
      <h1 id="home-title">时间如水。</h1>

      <div class="hero-description">
        <p>这里是 Sumoer 的个人研究与构建空间。</p>
        <p>
          我关注智能系统、界面，以及人在技术中的判断。把未定型的想法写下来，也把可以被使用的东西做出来。
        </p>
      </div>

      <nav class="hero-links" aria-label="首页主要入口">
        <a href="/research">
          <span>阅读研究</span>
          <span class="link-en meta" aria-hidden="true">Research</span>
        </a>
        <a href="/projects">
          <span>查看项目</span>
          <span class="link-en meta" aria-hidden="true">Projects</span>
        </a>
      </nav>

      <p class="hero-note meta" aria-hidden="true">Observe · make · let flow</p>
    </div>

    <figure class="shore-art" data-preserves-aspect="1122:1402">
      <img
        class="shore-artwork"
        src="/images/hero-watercolor-shore-v1.webp"
        alt=""
        width="1122"
        height="1402"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <canvas id="shore-light" aria-hidden="true" data-art-form="light-overlay"></canvas>
      <figcaption class="meta" aria-hidden="true">
        <span>Water study · 001</span>
        <span>Light / tide / time</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .shore-hero {
    position: relative;
    min-height: min(49rem, calc(100svh - 5.25rem));
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 18%, rgba(255, 255, 255, 0.92), transparent 27%),
      linear-gradient(112deg, #fffaf0 0%, #fbf4e6 60%, #f3eadb 100%);
    border-block: 1px solid rgba(23, 62, 70, 0.11);
  }

  .shore-hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: 0.34;
    background-image: repeating-linear-gradient(
      102deg,
      rgba(23, 62, 70, 0.018) 0,
      rgba(23, 62, 70, 0.018) 1px,
      transparent 1px,
      transparent 4px
    );
    mix-blend-mode: multiply;
  }

  .hero-frame {
    position: relative;
    display: grid;
    grid-template-columns: minmax(25rem, 1fr) auto;
    align-items: center;
    gap: clamp(4rem, 8vw, 8rem);
    width: min(100% - 5rem, 76rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(2rem, 4vh, 3rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 33rem;
    padding-top: 1rem;
  }

  .hero-kicker {
    margin-bottom: 1.4rem;
    color: #2b8f94;
  }

  h1 {
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.065em;
    color: #173e46;
  }

  .hero-description {
    display: grid;
    gap: 0.72rem;
    max-width: 29rem;
    margin-top: 2rem;
    font-family: var(--font-serif);
    color: rgba(23, 62, 70, 0.74);
  }

  .hero-description p:first-child {
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    color: #173e46;
  }

  .hero-description p:last-child {
    max-width: 27rem;
    font-size: clamp(0.95rem, 1.15vw, 1.06rem);
    line-height: 1.9;
  }

  .hero-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 29rem;
    margin-top: 2.4rem;
    border-block: 1px solid rgba(23, 62, 70, 0.18);
  }

  .hero-links a {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.92rem 1rem 0.92rem 0;
    color: #173e46;
    text-decoration: none;
  }

  .hero-links a + a {
    padding-left: 1rem;
    border-left: 1px solid rgba(23, 62, 70, 0.18);
  }

  .hero-links a::after {
    position: absolute;
    right: 1rem;
    bottom: -1px;
    left: 0;
    height: 2px;
    content: '';
    background: #66c7c3;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .hero-links a + a::after {
    left: 1rem;
  }

  .hero-links a:hover::after,
  .hero-links a:focus-visible::after {
    transform: scaleX(1);
  }

  .link-en {
    font-size: 0.63rem;
    color: rgba(23, 62, 70, 0.46);
  }

  .hero-note {
    margin-top: 1.35rem;
    color: rgba(23, 62, 70, 0.42);
  }

  .shore-art {
    --drift-x: 0px;
    --drift-y: 0px;
    position: relative;
    width: auto;
    height: min(77vh, 42.5rem);
    aspect-ratio: 1122 / 1402;
    margin: 0;
    overflow: hidden;
    background: #bfe8df;
    box-shadow:
      0 2.5rem 5rem rgba(36, 103, 107, 0.13),
      0 0 0 1px rgba(255, 255, 255, 0.62);
  }

  .shore-art::after {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.5);
  }

  .shore-artwork {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translate3d(var(--drift-x), var(--drift-y), 0) scale(1.018);
    transition: transform 900ms var(--ease-out);
    will-change: transform;
  }

  #shore-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.46;
    mix-blend-mode: screen;
  }

  figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    padding: 0.8rem 0.9rem;
    color: rgba(255, 255, 255, 0.72);
    text-shadow: 0 1px 10px rgba(29, 101, 106, 0.24);
    background: linear-gradient(transparent, rgba(34, 112, 112, 0.12));
  }

  @media (max-width: 58rem) {
    .hero-frame {
      grid-template-columns: minmax(20rem, 1fr) auto;
      gap: 2.5rem;
      width: min(100% - 3rem, 76rem);
    }

    .shore-art {
      height: min(70vh, 37rem);
    }

    h1 {
      font-size: clamp(3.6rem, 8vw, 5.5rem);
    }

    .hero-description p:first-child {
      font-size: 1.05rem;
    }
  }

  @media (max-width: 44rem) {
    .shore-hero {
      min-height: auto;
    }

    .hero-frame {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      width: min(100% - 2.5rem, 34rem);
      padding-block: 4rem 2.5rem;
    }

    .hero-copy {
      max-width: none;
      padding-top: 0;
    }

    h1 {
      font-size: clamp(3.65rem, 17vw, 5.4rem);
    }

    .hero-description,
    .hero-links {
      max-width: none;
    }

    .shore-art {
      justify-self: end;
      width: min(86vw, 28rem);
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shore-artwork {
      transform: none;
    }

    #shore-light {
      opacity: 0.32;
    }
  }
</style>

<script>
  const hero = document.querySelector('.shore-hero') as HTMLElement | null;
  const artwork = document.querySelector('.shore-art') as HTMLElement | null;
  const canvas = document.getElementById('shore-light') as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && artwork && canvas) {
    const heroElement = hero;
    const artworkElement = artwork;
    const lightCanvas = canvas;
    const ctx = lightCanvas.getContext('2d');
    let width = 0;
    let height = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;

    const glints = Array.from({ length: 22 }, (_, index) => ({
      x: 0.08 + ((index * 0.237) % 0.84),
      y: 0.06 + ((index * 0.173) % 0.84),
      size: 2 + (index % 5) * 1.2,
      phase: index * 1.87,
      alpha: 0.12 + (index % 4) * 0.035,
    }));

    function draw(time: number) {
      if (!ctx || !width || !height) return;
      ctx.clearRect(0, 0, width, height);
      ctx.save();
      ctx.globalCompositeOperation = 'screen';

      for (const glint of glints) {
        const x = glint.x * width + Math.sin(time * 0.00008 + glint.phase) * 4;
        const y = glint.y * height + Math.cos(time * 0.00007 + glint.phase) * 5;
        const pulse = 0.72 + Math.sin(time * 0.0007 + glint.phase) * 0.28;

        ctx.beginPath();
        ctx.ellipse(x, y, glint.size * 2.4, glint.size * 0.72, -0.34, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 244, ${glint.alpha * pulse})`;
        ctx.fill();
      }

      const sheenX = width * (0.35 + Math.sin(time * 0.000045) * 0.08);
      const sheenY = height * (0.3 + Math.cos(time * 0.000038) * 0.06);
      const sheen = ctx.createRadialGradient(sheenX, sheenY, 0, sheenX, sheenY, width * 0.42);
      sheen.addColorStop(0, 'rgba(255, 251, 215, 0.08)');
      sheen.addColorStop(0.52, 'rgba(221, 255, 243, 0.025)');
      sheen.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = sheen;
      ctx.fillRect(0, 0, width, height);
      ctx.restore();
    }

    function loop(time: number) {
      draw(time);
      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(loop);
    }

    function resize() {
      const rect = lightCanvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      lightCanvas.width = Math.round(width * dpr);
      lightCanvas.height = Math.round(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(0);
    }

    function syncMotion() {
      cancelAnimationFrame(raf);
      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(loop);
      else draw(0);
    }

    function moveArtwork(event: PointerEvent) {
      if (reduceMotion.matches) return;
      const rect = heroElement.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width - 0.5) * -7;
      const y = ((event.clientY - rect.top) / rect.height - 0.5) * -5;
      artworkElement.style.setProperty('--drift-x', `${x.toFixed(2)}px`);
      artworkElement.style.setProperty('--drift-y', `${y.toFixed(2)}px`);
    }

    function resetArtwork() {
      artworkElement.style.setProperty('--drift-x', '0px');
      artworkElement.style.setProperty('--drift-y', '0px');
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? true;
        syncMotion();
      },
      { threshold: 0.02 },
    );

    resize();
    observer.observe(lightCanvas);
    heroElement.addEventListener('pointermove', moveArtwork);
    heroElement.addEventListener('pointerleave', resetArtwork);
    window.addEventListener('resize', resize);
    reduceMotion.addEventListener('change', syncMotion);
  }
</script>
