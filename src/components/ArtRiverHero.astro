---
// ArtRiverHero — portrait watercolor artwork with an editorial copy column.
---

<section
  class="shore-hero"
  aria-labelledby="home-title"
  data-surface="pure-white"
  data-color-focus="sunlight-diagonal"
  data-motion-rhythm="6s-breathe-3s-highlight"
  data-type-system="editorial-serif-sans"
  data-intro-motion="per-load-word-reveal"
>
  <div class="hero-frame">
    <div class="hero-copy">
      <p class="hero-kicker">SUMOER — RESEARCH & BUILD / 2026</p>
      <h1
        id="home-title"
        aria-label="Be water, my friend."
        data-intro-state="playing"
        data-water-color="transparent-teal"
        data-friend-color="hermes-blue"
      >
        <span class="intro-line intro-line--water" aria-hidden="true">
          <span class="intro-be">Be</span>
          <span class="intro-space">&nbsp;</span>
          <span class="intro-water">water</span><span class="intro-comma">,</span>
        </span>
        <span class="intro-line intro-line--friend" aria-hidden="true">
          <span class="intro-letter" style="--letter-delay: 330ms">m</span>
          <span class="intro-letter" style="--letter-delay: 378ms">y</span>
          <span class="intro-space">&nbsp;</span>
          <span class="intro-letter" style="--letter-delay: 426ms">f</span>
          <span class="intro-letter" style="--letter-delay: 474ms">r</span>
          <span class="intro-letter" style="--letter-delay: 522ms">i</span>
          <span class="intro-letter" style="--letter-delay: 570ms">e</span>
          <span class="intro-letter" style="--letter-delay: 618ms">n</span>
          <span class="intro-letter" style="--letter-delay: 666ms">d</span>
          <span class="intro-letter" style="--letter-delay: 714ms">.</span>
        </span>
      </h1>

      <div class="hero-description">
        <p>
          关注智能系统、界面，以及人在技术中的判断。记录尚未定型的想法，也做可以被使用的东西。
        </p>
      </div>
    </div>

    <figure
      class="shore-art"
      data-preserves-aspect="1122:1402"
      data-edge-treatment="organic-feathered"
    >
      <div class="artwork-drift">
        <img
          class="shore-artwork"
          src="/images/hero-watercolor-shore-v1.webp"
          alt=""
          width="1122"
          height="1402"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <div class="shore-wash" aria-hidden="true"></div>
      <canvas id="shore-light" aria-hidden="true" data-art-form="light-overlay"></canvas>
    </figure>
  </div>
</section>

<style>
  .shore-hero {
    position: relative;
    min-height: min(49rem, calc(100svh - 5.25rem));
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    background: #fff;
    border: 0;
  }

  .shore-hero::before {
    position: absolute;
    inset: 0;
    content: '';
    pointer-events: none;
    opacity: 0.86;
    background:
      linear-gradient(
        132deg,
        rgba(246, 184, 55, 0.2) 0%,
        rgba(252, 210, 111, 0.13) 18%,
        rgba(255, 234, 178, 0.055) 36%,
        transparent 57%
      ),
      radial-gradient(
        ellipse 36% 42% at 7% 4%,
        rgba(249, 190, 65, 0.2),
        rgba(255, 225, 152, 0.065) 48%,
        transparent 78%
      ),
      repeating-linear-gradient(
        102deg,
        rgba(23, 62, 70, 0.012) 0,
        rgba(23, 62, 70, 0.012) 1px,
        transparent 1px,
        transparent 4px
      );
  }

  .hero-frame {
    position: relative;
    display: grid;
    grid-template-columns: minmax(25rem, 1fr) auto;
    align-items: center;
    gap: clamp(4rem, 8vw, 8rem);
    width: min(100% - 5rem, 76rem);
    min-height: inherit;
    margin-inline: auto;
    padding-block: clamp(2rem, 4vh, 3rem);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    max-width: 34rem;
    padding-top: 0.5rem;
  }

  .hero-kicker {
    margin-bottom: 1.45rem;
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.7;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(23, 62, 70, 0.57);
  }

  h1 {
    font-family: "Iowan Old Style", Baskerville, "Times New Roman", serif;
    font-size: clamp(4.25rem, 6.62vw, 5.5rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #173e46;
  }

  .intro-line {
    display: block;
    width: max-content;
    max-width: 100%;
    transform-origin: left center;
  }

  .intro-line--water {
    font-style: italic;
    font-weight: 500;
  }

  .intro-be {
    color: rgba(23, 62, 70, 0.68);
  }

  .intro-water,
  .intro-comma {
    color: rgba(43, 143, 148, 0.46);
    text-shadow: 0 0 1.2rem rgba(102, 199, 195, 0.14);
  }

  .intro-line--friend {
    font-weight: 700;
    color: #0000f2;
  }

  .intro-letter {
    display: inline-block;
  }

  h1[data-intro-state='playing'] .intro-line--water {
    animation: intro-group-in 380ms var(--ease-out) 60ms both;
  }

  h1[data-intro-state='playing'] .intro-letter {
    animation: intro-letter-in 300ms var(--ease-out) var(--letter-delay) both;
  }

  .hero-description {
    max-width: 27rem;
    margin-top: 2.2rem;
    font-family: var(--font-sans);
    color: rgba(23, 62, 70, 0.74);
  }

  .hero-description p {
    max-width: 26.5rem;
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    line-height: 1.78;
  }

  .shore-art {
    position: relative;
    width: auto;
    height: min(77vh, 42.5rem);
    aspect-ratio: 1122 / 1402;
    margin: 0;
    overflow: hidden;
    background: transparent;
    border-radius: 27% 8% 30% 11% / 13% 24% 16% 28%;
    -webkit-mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.3) 4%,
        #000 12%,
        #000 91%,
        rgba(0, 0, 0, 0.38) 97%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.45) 5%,
        #000 12%,
        #000 90%,
        rgba(0, 0, 0, 0.3) 96%,
        transparent 100%
      );
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.3) 4%,
        #000 12%,
        #000 91%,
        rgba(0, 0, 0, 0.38) 97%,
        transparent 100%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.45) 5%,
        #000 12%,
        #000 90%,
        rgba(0, 0, 0, 0.3) 96%,
        transparent 100%
      );
    mask-composite: intersect;
  }

  .artwork-drift {
    --drift-x: 0px;
    --drift-y: 0px;
    position: absolute;
    inset: -1.8%;
    transform: translate3d(var(--drift-x), var(--drift-y), 0);
    transition: transform 900ms var(--ease-out);
    will-change: transform;
  }

  .shore-artwork {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: watercolor-breathe 6s ease-in-out infinite alternate;
    will-change: transform;
  }

  .shore-wash {
    position: absolute;
    inset: -24%;
    pointer-events: none;
    opacity: 0.42;
    background:
      radial-gradient(circle at 32% 28%, rgba(255, 248, 201, 0.38), transparent 24%),
      radial-gradient(circle at 68% 58%, rgba(202, 255, 239, 0.25), transparent 28%),
      radial-gradient(circle at 42% 78%, rgba(255, 255, 255, 0.2), transparent 18%);
    filter: blur(18px);
    mix-blend-mode: screen;
    animation: wash-drift 13s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .shore-wash::after {
    position: absolute;
    inset: 21% 10% 16% 14%;
    content: '';
    opacity: 0.42;
    background:
      radial-gradient(circle at 28% 24%, rgba(255, 255, 226, 0.78), transparent 12%),
      radial-gradient(circle at 64% 56%, rgba(231, 255, 247, 0.58), transparent 17%),
      radial-gradient(circle at 42% 76%, rgba(255, 244, 201, 0.5), transparent 11%);
    mix-blend-mode: screen;
    animation: highlight-pulse 3s ease-in-out infinite;
  }

  #shore-light {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.64;
    mix-blend-mode: screen;
  }

  @keyframes watercolor-breathe {
    0% {
      transform: translate3d(-0.35%, 0.15%, 0) scale(1.025);
    }

    100% {
      transform: translate3d(0.45%, -0.45%, 0) scale(1.045);
    }
  }

  @keyframes wash-drift {
    0% {
      opacity: 0.32;
      transform: translate3d(-4%, -2%, 0) rotate(-2deg);
    }

    100% {
      opacity: 0.54;
      transform: translate3d(5%, 4%, 0) rotate(2deg);
    }
  }

  @keyframes highlight-pulse {
    0%,
    100% {
      opacity: 0.24;
      transform: translate3d(-1.5%, 1%, 0) scale(0.98);
    }

    50% {
      opacity: 0.68;
      transform: translate3d(1.5%, -1%, 0) scale(1.035);
    }
  }

  @keyframes intro-group-in {
    from {
      opacity: 0;
      filter: blur(4px);
      transform: translate3d(0, 0.16em, 0);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes intro-letter-in {
    from {
      opacity: 0;
      filter: blur(3px);
      transform: translate3d(0, 0.18em, 0);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translate3d(0, 0, 0);
    }
  }

  @media (max-width: 58rem) {
    .hero-frame {
      grid-template-columns: minmax(20rem, 1fr) auto;
      gap: 2.5rem;
      width: min(100% - 3rem, 76rem);
    }

    .shore-art {
      height: min(70vh, 37rem);
    }

    h1 {
      font-size: clamp(3.6rem, 8vw, 5.5rem);
    }

  }

  @media (max-width: 44rem) {
    .shore-hero {
      min-height: auto;
    }

    .hero-frame {
      grid-template-columns: 1fr;
      gap: 2.75rem;
      width: min(100% - 2.5rem, 34rem);
      padding-block: 4rem 2.5rem;
    }

    .hero-copy {
      max-width: none;
      padding-top: 0;
    }

    h1 {
      font-size: clamp(3.65rem, 17vw, 5.4rem);
    }

    .hero-description {
      max-width: none;
    }

    .shore-art {
      justify-self: end;
      width: min(86vw, 28rem);
      height: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1[data-intro-state] .intro-line,
    h1[data-intro-state] .intro-letter {
      opacity: 1;
      filter: none;
      transform: none;
      animation: none;
    }

    .shore-artwork,
    .shore-wash,
    .shore-wash::after {
      animation: none;
    }

    .artwork-drift {
      transform: none;
    }

    #shore-light {
      opacity: 0.32;
    }
  }
</style>

<script>
  const hero = document.querySelector('.shore-hero') as HTMLElement | null;
  const artwork = document.querySelector('.artwork-drift') as HTMLElement | null;
  const canvas = document.getElementById('shore-light') as HTMLCanvasElement | null;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && artwork && canvas) {
    const heroElement = hero;
    const artworkElement = artwork;
    const lightCanvas = canvas;
    const ctx = lightCanvas.getContext('2d');
    let width = 0;
    let height = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;

    const glints = Array.from({ length: 30 }, (_, index) => ({
      x: 0.08 + ((index * 0.237) % 0.84),
      y: 0.06 + ((index * 0.173) % 0.84),
      size: 2 + (index % 5) * 1.2,
      phase: index * 1.87,
      alpha: 0.14 + (index % 4) * 0.04,
    }));

    function draw(time: number) {
      if (!ctx || !width || !height) return;
      ctx.clearRect(0, 0, width, height);
      ctx.save();
      ctx.globalCompositeOperation = 'screen';

      for (const glint of glints) {
        const x = glint.x * width + Math.sin(time * 0.00008 + glint.phase) * 4;
        const y = glint.y * height + Math.cos(time * 0.00007 + glint.phase) * 5;
        const pulse = 0.72 + Math.sin(time * 0.0021 + glint.phase) * 0.28;

        ctx.beginPath();
        ctx.ellipse(x, y, glint.size * 2.4, glint.size * 0.72, -0.34, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255, 255, 244, ${glint.alpha * pulse})`;
        ctx.fill();
      }

      for (let ribbon = 0; ribbon < 4; ribbon += 1) {
        const baseY = height * (0.14 + ribbon * 0.16);
        const endX = width * (0.9 - ribbon * 0.045);
        ctx.beginPath();

        for (let index = 0; index <= 28; index += 1) {
          const x = (index / 28) * endX;
          const y =
            baseY +
            Math.sin(index * 0.62 + time * 0.00034 + ribbon * 1.7) * (2.5 + ribbon) +
            Math.cos(index * 0.21 + ribbon) * 2;
          if (index === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }

        ctx.strokeStyle = `rgba(255, 255, 244, ${0.055 + ribbon * 0.012})`;
        ctx.lineWidth = 0.9 + ribbon * 0.18;
        ctx.lineCap = 'round';
        ctx.setLineDash([18 + ribbon * 5, 22, 5, 16]);
        ctx.lineDashOffset = -time * (0.004 + ribbon * 0.001);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      const sheenX = width * (0.35 + Math.sin(time * 0.000045) * 0.08);
      const sheenY = height * (0.3 + Math.cos(time * 0.000038) * 0.06);
      const sheen = ctx.createRadialGradient(sheenX, sheenY, 0, sheenX, sheenY, width * 0.42);
      sheen.addColorStop(0, 'rgba(255, 251, 215, 0.08)');
      sheen.addColorStop(0.52, 'rgba(221, 255, 243, 0.025)');
      sheen.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = sheen;
      ctx.fillRect(0, 0, width, height);
      ctx.restore();
    }

    function loop(time: number) {
      draw(time);
      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(loop);
    }

    function resize() {
      const rect = lightCanvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      lightCanvas.width = Math.round(width * dpr);
      lightCanvas.height = Math.round(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      draw(0);
    }

    function syncMotion() {
      cancelAnimationFrame(raf);
      if (visible && !reduceMotion.matches) raf = requestAnimationFrame(loop);
      else draw(0);
    }

    function moveArtwork(event: PointerEvent) {
      if (reduceMotion.matches) return;
      const rect = heroElement.getBoundingClientRect();
      const x = ((event.clientX - rect.left) / rect.width - 0.5) * -4;
      const y = ((event.clientY - rect.top) / rect.height - 0.5) * -3;
      artworkElement.style.setProperty('--drift-x', `${x.toFixed(2)}px`);
      artworkElement.style.setProperty('--drift-y', `${y.toFixed(2)}px`);
    }

    function resetArtwork() {
      artworkElement.style.setProperty('--drift-x', '0px');
      artworkElement.style.setProperty('--drift-y', '0px');
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry?.isIntersecting ?? true;
        syncMotion();
      },
      { threshold: 0.02 },
    );

    resize();
    observer.observe(lightCanvas);
    heroElement.addEventListener('pointermove', moveArtwork);
    heroElement.addEventListener('pointerleave', resetArtwork);
    window.addEventListener('resize', resize);
    reduceMotion.addEventListener('change', syncMotion);
  }
</script>
