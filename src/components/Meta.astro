---
// Meta — 小号英文 mono 元信息行（日期 / 类型 / 标签等）
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<p class="meta-line">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="meta-sep" aria-hidden="true">·</span>}
      <span>{item}</span>
    </>
  ))}
</p>

<style>
  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0;
  }

  .meta-sep {
    color: var(--color-ink-faint);
  }
</style>
