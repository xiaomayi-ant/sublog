# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
.worktrees/
worktrees/

# 部署运维：只在本地保留。
# 仓库是公开的，而这些文件写着生产机 IP、部署用户与目录结构 ——
# 对读代码的人没有价值，对扫 SSH 的人有。想公开的话补一次提交即可，反过来要改写历史。
docs/deployment.md
scripts/deploy-site.mjs
scripts/server/
tests/deployment-contract.test.mjs

# 知识图谱的本地 SQLite：增量抽取用的缓存，二进制不入库。
# 入库的是同一次抽取导出的 data/graph.json —— 构建期读的是它，
# 所以 CI 从干净 checkout 也能建出完整图谱。
data/*.db

# github-digest 的增量判断缓存：只是"这条已经判过、结果是什么"的本地记忆，
# 入库的是同一次运行导出的 data/github-activity.json，道理和上面的 .db 一样。
data/github-activity-cache.json

# 视觉基线比对时落下的当前帧：临时产物，用来和入库的基线并排看，看完即弃。
tests/baselines/**/*.current.png

# scheduler-hub 定时跑 github-digest 时落的本地日志
.github-digest.log
.github-digest.error.log
